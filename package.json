{
	"name": "obsidian-ai",
	"version": "1.2.4",
	"description": "AI-powered assistant for Obsidian with inline editing and persistent chat",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:watch": "vitest --config vitest.e2e.config.ts",
		"package": "pnpm run build && mkdir -p dist && zip dist/obsidian-ai-$(date +'%Y%m%d%H%M%S').zip main.js manifest.json styles.css",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"ai",
		"chat",
		"ollama",
		"openai"
	],
	"author": "space-cadet",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/space-cadet/obsidian-ai.git"
	},
	"bugs": {
		"url": "https://github.com/space-cadet/obsidian-ai/issues"
	},
	"homepage": "https://github.com/space-cadet/obsidian-ai#readme",
	"devDependencies": {
		"@ai-sdk/provider": "3.0.10",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/codemirror": "^5.60.15",
		"@types/node": "^20.19.41",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.11.0",
		"@typescript-eslint/parser": "^8.11.0",
		"@vitest/coverage-v8": "^4.1.7",
		"builtin-modules": "^4.0.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.25.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^15.5.2",
		"obsidian": "latest",
		"prettier": "^3.6.2",
		"typescript": "^5.6.3",
		"vitest": "^4.1.7"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,css,scss,md,json,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ai-sdk/anthropic": "3.0.74",
		"@ai-sdk/deepseek": "2.0.32",
		"@ai-sdk/google": "3.0.79",
		"@ai-sdk/openai": "3.0.58",
		"@codemirror/autocomplete": "^6.18.4",
		"@codemirror/commands": "^6.8.0",
		"@codemirror/state": "^6.5.1",
		"@codemirror/view": "^6.36.2",
		"@openrouter/ai-sdk-provider": "2.9.0",
		"@types/diff-match-patch": "^1.0.36",
		"ai": "6.0.174",
		"diff-match-patch": "^1.0.5",
		"ollama-ai-provider": "1.2.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"zod": "^3.25.76"
	}
}
